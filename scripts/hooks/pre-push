#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
records=$(cat)
case "${2:-}" in
  https://github.com/HJK6/pentacle-mobile|https://github.com/HJK6/pentacle-mobile.git|git@github.com:HJK6/pentacle-mobile|git@github.com:HJK6/pentacle-mobile.git) ;;
  *) echo 'public mobile guard: refused unexpected destination' >&2; exit 1 ;;
esac
[ -z "$(git status --porcelain)" ] || { echo 'public mobile guard: refused dirty candidate' >&2; exit 1; }
head=$(git rev-parse HEAD)
printf '%s\n' "$records" | while read -r local_ref tip remote_ref prior; do
  case "$tip" in ''|*[!0]*) ;;
    *) continue ;;
  esac
  [ "$(git rev-parse "$tip^{commit}")" = "$head" ] || {
    echo 'public mobile guard: pushed tip must match checked-out candidate' >&2; exit 1;
  }
done
git fetch --quiet --no-tags "${1}" main
scripts/check-public-boundary.sh FETCH_HEAD
# Private terms: the host-local dictionary never enters the repo or CI, so this
# runs only here, against the exact outgoing commit. Any failure refuses.
terms_file=${PENTACLE_PRIVATE_TERMS_FILE:-${HOME:-}/.config/pentacle/private-terms.json}
receipt_dir="$(git rev-parse --absolute-git-dir)/private-terms-receipts"
mkdir -p "$receipt_dir"
receipt="$receipt_dir/$head.json"
if python3 scripts/check_private_terms.py --commit "$head" --private-terms-file "$terms_file" > "$receipt"; then
  echo "public mobile guard: private terms checked, zero hits (receipt $receipt)" >&2
else
  echo "public mobile guard: refused; private-terms check did not pass (receipt $receipt)" >&2
  exit 1
fi
[ -z "$(git status --porcelain)" ] || { echo 'public mobile guard: check mutated the candidate' >&2; exit 1; }
[ "$(git rev-parse HEAD)" = "$head" ] || { echo 'public mobile guard: candidate moved during check' >&2; exit 1; }
# exec preserves the original git-push parent PID used by the history guard.
exec scripts/hooks/history-pre-push "$@" <<PUSH_RECORDS
$records
PUSH_RECORDS
