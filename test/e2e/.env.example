# Optional device identifier used by a local adapter.
PENTACLE_DEVICE_UDID=00000000-0000-0000-0000-000000000000

# Optional hardware identifier used by a local adapter.
PENTACLE_HARDWARE_UDID=0000000000000000000000000000000000000000

# Bundle identifier for a locally installed example app.
PENTACLE_BUNDLE_ID=com.example.pentacle

# Optional application package path.
PENTACLE_TEST_IPA=

# Optional explicitly supplied mock-server URL.
PENTACLE_DAEMON_WS_URL=

# Optional local fixture command; leave blank for the built-in adapter.
PENTACLE_EVENT_REPLAY_COMMAND=

# Optional local scroll adapter command.
PENTACLE_CODEX_SCROLL_COMMAND=

# Optional local foreground/background adapter command.
PENTACLE_BIOMETRIC_RESUME_COMMAND=
