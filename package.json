{
  "name": "pentacle-mobile",
  "version": "2.0.0",
  "description": "Mobile client for Pentacle.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJK6/pentacle-mobile.git"
  },
  "bugs": {
    "url": "https://github.com/HJK6/pentacle-mobile/issues"
  },
  "homepage": "https://github.com/HJK6/pentacle-mobile#readme",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:prod-build-guardrails": "jest --runTestsByPath tests/prodBuildGuardrails.test.ts --runInBand",
    "typecheck": "tsc --noEmit",
    "validate": "tsc --noEmit && npx expo export --platform ios --output-dir /tmp/expo-validate-build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --runInBand"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/rajdhani": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@noble/hashes": "2.2.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "^8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "^0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "^15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "pentacle-chat-core": "file:./pentacle-chat-core",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "expo-file-system": "~19.0.16",
    "expo-asset": "~11.1.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "playwright": "^1.60.0",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "jest": {
    "watchman": false,
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "reporters": [
      "default"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/pentacle-chat-core/tests/"
    ],
    "moduleNameMapper": {
      "^pentacle-chat-core$": "<rootDir>/pentacle-chat-core/src/index.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|@noble/hashes/.*|react-navigation|@react-navigation/.*|react-native-svg|zustand|pentacle-chat-core))"
    ]
  }
}
